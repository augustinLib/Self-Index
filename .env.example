# Optimizer (index evolution); several replicas are comma-separated
LLM_BASE_URL=http://localhost:8000/v1

# LongMemEval-V2 memory encoder
# EMBEDDING_BASE_URL=http://localhost:8100/v1

# BrowseComp-Plus search agent, and the judge (also the LongMemEval-V2 evaluator)
# AGENT_BASE_URL=http://localhost:8200/v1
# JUDGE_BASE_URL=http://localhost:8300/v1

# LongMemEval-V2 reader, and the API key sent to every endpoint
# READER_BASE_URL=http://localhost:8400/v1
# OPENAI_API_KEY=

# Hosted BrowseComp-Plus agents: Gemini-3.7-Flash and Kimi-K2.5 (through OpenRouter)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Torch devices for the encoders, the index and the searchers (comma-separated; cuda:0 by default)
# DEVICES=cuda:0
